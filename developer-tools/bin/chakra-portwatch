#!/bin/bash
# chakra-portwatch -- Chakra developer port inspector.
#
# What's listening on this machine, who owns it, and whether it's only
# on localhost or exposed to the network. Answers the everyday dev
# questions: "what's on port 3000?", "is my dev server bound to
# 0.0.0.0 by accident?", "what did that stale node process leave open?".
#
# Process/PID/command is shown for YOUR OWN processes without root; for
# everything else, run with sudo. Risk tier 0 (read-only).
#
# Usage:
#   chakra-portwatch [--json]        list listening TCP/UDP sockets
#   chakra-portwatch <port>          what is on this port (+ how to kill it)
#   chakra-portwatch --watch         refresh every 2s until Ctrl-C
set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

json=0 watch=0 one_port=""
for a in "$@"; do
  case "$a" in
    --json)  json=1 ;;
    --watch) watch=1 ;;
    [0-9]*)  one_port="$a" ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "chakra-portwatch: unknown argument '$a'" >&2; exit 1 ;;
  esac
done

# ss -H: no header. -tulnp: tcp+udp, listening, numeric, process.
# Fields we care about: proto, Local Address:Port, Process ("users:((...))").
_rows() {
  ss -H -tulnp 2>/dev/null | awk '
    {
      proto=$1
      # Local Address:Port is field 5 for tcp -l, but udp has no state col.
      # Normalise: the addr:port token is the one containing the last ":".
      addr=""; for (i=1;i<=NF;i++) if ($i ~ /:[0-9]+$/ && $i !~ /users:/) addr=$i
      n=split(addr,a,":"); port=a[n]; host=addr; sub(/:[0-9]+$/,"",host)
      # process blob
      proc=""
      if (match($0,/users:\(\(.*\)\)/)) proc=substr($0,RSTART,RLENGTH)
      pname=""; pid=""
      if (proc!="") {
        if (match(proc,/"[^"]+"/)) pname=substr(proc,RSTART+1,RLENGTH-2)
        if (match(proc,/pid=[0-9]+/)) { pid=substr(proc,RSTART+4,RLENGTH-4) }
      }
      if (port !~ /^[0-9]+$/) next
      scope = (host=="0.0.0.0"||host=="[::]"||host=="*") ? "EXPOSED" : \
              (host ~ /^127\.|^\[::1\]/) ? "local" : host
      printf "%s|%s|%s|%s|%s|%s\n", proto, port, host, scope, (pname==""?"-":pname), (pid==""?"-":pid)
    }' | sort -t'|' -k2 -n -u
}

_print_table() {
  local any=0
  printf '%-5s %-7s %-9s %-24s %-18s %s\n' PROTO PORT SCOPE ADDRESS PROCESS PID
  while IFS='|' read -r proto port host scope pname pid; do
    [[ -z "$proto" ]] && continue
    any=1
    printf '%-5s %-7s %-9s %-24s %-18s %s\n' "$proto" "$port" "$scope" "$host" "$pname" "$pid"
  done < <(_rows)
  [[ $any -eq 0 ]] && echo "  (nothing listening -- or run with sudo to see other users' sockets)"
}

_json() {
  _rows | jq -R -c 'split("|") | {proto:.[0], port:(.[1]|tonumber), address:.[2], scope:.[3], process:.[4], pid:.[5]}' \
        | jq -s -c .
}

if [[ -n "$one_port" ]]; then
  echo "Port $one_port"
  echo "==========="
  hit=0
  while IFS='|' read -r proto port host scope pname pid; do
    [[ "$port" == "$one_port" ]] || continue
    hit=1
    echo "  $proto  $host  ($scope)  ->  ${pname} (pid ${pid})"
    if [[ "$pid" != "-" && -r "/proc/$pid/cmdline" ]]; then
      echo "     cmd: $(tr '\0' ' ' < "/proc/$pid/cmdline")"
      echo "     cwd: $(readlink -f "/proc/$pid/cwd" 2>/dev/null || echo '?')"
      echo "     kill it: kill $pid    (or: kill -9 $pid)"
    elif [[ "$pid" != "-" ]]; then
      echo "     (owned by another user -- 'sudo chakra-portwatch $one_port' for details)"
    fi
  done < <(_rows)
  [[ $hit -eq 0 ]] && echo "  nothing is listening on port $one_port."
  exit 0
fi

if [[ $watch -eq 1 ]]; then
  trap 'tput cnorm 2>/dev/null; exit 0' INT
  tput civis 2>/dev/null
  while true; do
    clear
    echo "Chakra Port Watch  --  $(date '+%H:%M:%S')   (Ctrl-C to stop)"
    echo
    _print_table
    sleep 2
  done
fi

if [[ $json -eq 1 ]]; then _json; else
  echo "Chakra Port Watch"
  echo "================="
  _print_table
fi
