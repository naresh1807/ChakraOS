#!/bin/bash
# chakra-clean -- reclaim space.
#
# On a live session '/' is a RAM overlay, so a full apt cache or a
# runaway ~/.cache eats actual memory. This clears the safe-to-clear
# caches and shows you the before/after.
#
# It shows a plan with sizes first, then asks -- unless you pass --yes.
# Nothing here removes your data; the riskiest item (apt autoremove) is
# opt-in with --autoremove.
#
# Usage:
#   chakra-clean                 show the plan, ask, then clean
#   chakra-clean --yes           don't ask
#   chakra-clean --dry-run       show the plan and stop
#   sudo chakra-clean --autoremove   also apt-get autoremove --purge
set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

assume_yes=0 dry=0 autoremove=0
for a in "$@"; do
  case "$a" in
    --yes|-y)     assume_yes=1 ;;
    --dry-run|-n) dry=1 ;;
    --autoremove) autoremove=1 ;;
    -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "chakra-clean: unknown argument '$a'" >&2; exit 1 ;;
  esac
done

_sz() { du -sh "$@" 2>/dev/null | awk '{s=$1}END{print s?s:"0"}'; }
_free() { df -h --output=avail / 2>/dev/null | tail -1 | tr -d ' '; }

echo "Chakra Clean"
echo "==========="
echo "Free on / now: $(_free)"
echo
echo "Plan:"
declare -a jobs
if [[ $EUID -eq 0 ]]; then
  printf '  apt package cache            %s\n' "$(_sz /var/cache/apt/archives 2>/dev/null)"
  jobs+=("apt-get clean")
  printf '  journal (keep last 50M)      %s\n' "$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMG]' | head -1)"
  jobs+=("journalctl --vacuum-size=50M")
else
  echo "  (run with sudo to also clear the apt cache and vacuum the system journal)"
fi
printf '  ~/.cache                      %s\n' "$(_sz "$HOME/.cache")"
jobs+=("rm -rf \"$HOME/.cache\"/*")
printf '  ~ thumbnail cache             %s\n' "$(_sz "$HOME/.thumbnails" "$HOME/.cache/thumbnails")"
jobs+=("rm -rf \"$HOME/.thumbnails\" \"$HOME/.cache/thumbnails\"")
printf '  /tmp, /var/tmp (files >1 day) %s\n' "$( { find /tmp /var/tmp -mtime +1 -type f -print0 2>/dev/null | du -ch --files0-from=- 2>/dev/null | tail -1 | awk '{print $1}'; } )"
jobs+=("find /tmp /var/tmp -mtime +1 -type f -delete 2>/dev/null; true")
if command -v podman >/dev/null 2>&1 && [[ -n "$(podman ps -aq 2>/dev/null)$(podman images -q 2>/dev/null)" ]]; then
  printf '  podman dangling data          %s\n' "$(podman system df 2>/dev/null | awk '/Images/{print $4}')"
  jobs+=("podman system prune -f >/dev/null 2>&1; true")
fi
[[ $autoremove -eq 1 && $EUID -eq 0 ]] && jobs+=("DEBIAN_FRONTEND=noninteractive apt-get -y autoremove --purge")
echo

[[ $dry -eq 1 ]] && { echo "(dry run -- nothing removed)"; exit 0; }

if [[ $assume_yes -eq 0 ]]; then
  read -r -p "Proceed? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
fi

for j in "${jobs[@]}"; do eval "$j" 2>/dev/null || true; done

echo
echo "Done. Free on / now: $(_free)"
