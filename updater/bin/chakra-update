#!/bin/bash
# chakra-update -- Chakra's update front-end.
#
# Wraps apt with the context that matters on Chakra: which Chakra
# version you're on, what's upgradable, what would need a service
# restart afterwards, and -- loudly -- that on a LIVE SESSION none of
# this survives a reboot.
#
# Usage:
#   chakra-update              refresh the index + show what's upgradable
#   sudo chakra-update --apply run the full-upgrade
#   chakra-update --json       machine-readable summary
set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

apply=0 json=0
for a in "$@"; do
  case "$a" in
    --apply) apply=1 ;;
    --json)  json=1 ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "chakra-update: unknown argument '$a'" >&2; exit 1 ;;
  esac
done

# live-boot? (Debian live-boot leaves this marker / mounts / as overlay)
is_live=0
{ [[ -d /run/live ]] || grep -qs 'boot=live' /proc/cmdline; } && is_live=1

chakra_ver="$(. /etc/chakra-release 2>/dev/null; echo "${CHAKRA_VERSION:-?} (${CHAKRA_CODENAME:-?})")"

if [[ $EUID -eq 0 ]]; then
  apt-get update -qq 2>/dev/null
else
  # non-root can't update the index; use what's cached and say so.
  :
fi

mapfile -t upg < <(apt-get -s -o Debug::NoLocking=true upgrade 2>/dev/null | awk '/^Inst /{print $2" "$3}')
sec=$(apt-get -s -o Debug::NoLocking=true upgrade 2>/dev/null | grep -c 'Debian-Security\|Security')

if [[ $json -eq 1 ]]; then
  jq -n --arg chakra "$chakra_ver" --argjson live "$is_live" \
     --argjson count "${#upg[@]}" --argjson security "$sec" \
     --argjson pkgs "$(printf '%s\n' "${upg[@]:-}" | jq -R 'select(.!="")' | jq -s .)" \
     '{chakra_version:$chakra, live_session:($live==1), upgradable:$count, security:$security, packages:$pkgs}'
  exit 0
fi

echo "Chakra Update"
echo "============="
echo "Chakra OS:   $chakra_ver"
[[ $EUID -ne 0 ]] && echo "Index:       not refreshed (run as root, or: sudo chakra-update)"
echo

if [[ ${#upg[@]} -eq 0 ]]; then
  echo "Everything is up to date."
else
  echo "${#upg[@]} package(s) upgradable${sec:+  (~$sec security)}:"
  printf '  %s\n' "${upg[@]}" | head -40
  [[ ${#upg[@]} -gt 40 ]] && echo "  ... and $(( ${#upg[@]} - 40 )) more"
fi
echo

if [[ $is_live -eq 1 ]]; then
  echo "NOTE: live session -- '/' is a RAM overlay. Upgrades apply now but are"
  echo "      GONE on reboot. Persisting them needs an installed system (there"
  echo "      is no installer phase yet -- see docs/roadmap.md)."
  echo
fi
echo "Chakra's own components (chakra-*, the ISO itself) are not updated"
echo "in place -- rebuild/re-flash from a newer ISO. This tool is for the"
echo "Debian base underneath."
echo

if [[ $apply -eq 1 ]]; then
  [[ $EUID -eq 0 ]] || { echo "--apply needs root: sudo chakra-update --apply" >&2; exit 1; }
  [[ ${#upg[@]} -eq 0 ]] && exit 0
  echo "Running full-upgrade..."
  DEBIAN_FRONTEND=noninteractive apt-get -y full-upgrade
  echo
  if command -v needrestart >/dev/null 2>&1; then
    echo "Services that may need a restart:"
    needrestart -b 2>/dev/null | grep -E 'NEEDRESTART-(SVC|KSTA)' || echo "  (needrestart found nothing)"
  else
    echo "Install 'needrestart' to see which services need restarting after an upgrade."
  fi
elif [[ ${#upg[@]} -gt 0 ]]; then
  echo "To apply:  sudo chakra-update --apply"
fi
