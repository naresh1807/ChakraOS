#!/bin/bash
# chakra-sentinel -- Chakra OS's system agent, Phase 7 (read-only mode).
#
# Architecture (matches the master manual's AI safety principle exactly):
#   query -> Intent Engine (deterministic pattern match, this script)
#          -> Chakra system API (one of the Phase 6 tools, Risk 0 only)
#          -> Chakra Audit (every dispatch logged)
#          -> [optional] a hosted LLM explains the ALREADY-COLLECTED output
#
# The explain layer -- Google Gemini or NVIDIA NIM, whichever key is set
# -- NEVER decides which tool runs or touches the system directly. It
# only ever sees data the deterministic dispatcher already fetched. With
# no key set, Sentinel is fully offline and still fully functional; the
# LLM only adds a plain-language explanation on top. See
# /etc/chakra/sentinel.conf and ai-agent/README.md for the reasoning.
# No key is ever shipped in the image -- each user brings their own.
#
# Usage:
#   chakra-sentinel "why is my system slow?"
#   chakra-sentinel                # interactive mode
set -u

BIN=/usr/lib/chakra/bin
CONF=/etc/chakra/sentinel.conf
MODE="${CHAKRA_SENTINEL_MODE:-daily}"

# Explain-layer config (from /etc/chakra/sentinel.conf; all blank by default).
NIM_API_KEY=""
NIM_MODEL="meta/llama-3.1-8b-instruct"
NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
SENTINEL_LLM=""   # force a provider: gemini | nim | none. blank = auto-pick
# shellcheck disable=SC1090
[[ -f "$CONF" ]] && source "$CONF" 2>/dev/null
# CHAKRA_* env vars override the config file (handy for testing)
GEMINI_API_KEY="${CHAKRA_GEMINI_API_KEY:-$GEMINI_API_KEY}"
NIM_API_KEY="${CHAKRA_NIM_API_KEY:-$NIM_API_KEY}"
SENTINEL_LLM="${CHAKRA_SENTINEL_LLM:-$SENTINEL_LLM}"

audit() {
  # No 2>/dev/null here on purpose: if the audit record can't be written
  # (e.g. this user isn't in the adm group) chakra-audit-log says so on
  # stderr. A dispatch that isn't audited should be visible, not silent.
  "$BIN/chakra-audit-log" --actor "chakra-sentinel" --action "$1" \
    --target "localhost" --risk-tier 0 --approved-by "auto (risk-0, mode=$MODE)" \
    --result "$2" || true
}

# Which hosted LLM (if any) explains the collected output. The explain
# layer is NEVER in the decision path -- see ai-agent/README.md.
_llm_provider() {
  case "${SENTINEL_LLM,,}" in
    none)   echo none; return ;;
    gemini) [[ -n "$GEMINI_API_KEY" ]] && { echo gemini; return; }; echo none; return ;;
    nim)    [[ -n "$NIM_API_KEY"    ]] && { echo nim;    return; }; echo none; return ;;
  esac
  [[ -n "$GEMINI_API_KEY" ]] && { echo gemini; return; }
  [[ -n "$NIM_API_KEY"    ]] && { echo nim;    return; }
  echo none
}

_SYS_PROMPT="You are Chakra Sentinel, a system assistant. You are given the ALREADY-COLLECTED output of a read-only system command. Explain it clearly and briefly for the user. Do not invent data not present in the output. Do not suggest running commands that were not already run."

# Each *_explain takes the question + the tool's raw output and prints a
# plain-language explanation, or returns non-zero on any failure (the
# caller then just shows the raw output -- it never blocks on the network).
_nim_explain() {
  local q="$1" data="$2" body resp text
  command -v curl >/dev/null 2>&1 || return 1
  body=$(jq -n --arg model "$NIM_MODEL" --arg sys "$_SYS_PROMPT" --arg q "$q" --arg d "$data" '
    {model:$model, max_tokens:300, temperature:0.3, messages:[
      {role:"system", content:$sys},
      {role:"user", content:("Question: " + $q + "\n\nCommand output:\n" + $d)}
    ]}')
  resp=$(curl -sS --max-time 15 -X POST "$NIM_BASE_URL/chat/completions" \
    -H "Authorization: Bearer $NIM_API_KEY" -H "Content-Type: application/json" \
    -d "$body" 2>/dev/null)
  text=$(echo "$resp" | jq -r '.choices[0].message.content // empty' 2>/dev/null)
  [[ -n "$text" ]] && { printf '%s\n' "$text"; return 0; }
  return 1
}

_gemini_explain() {
  local q="$1" data="$2" body resp text
  command -v curl >/dev/null 2>&1 || return 1
  body=$(jq -n --arg sys "$_SYS_PROMPT" --arg q "$q" --arg d "$data" '
    {systemInstruction:{parts:[{text:$sys}]},
     contents:[{role:"user", parts:[{text:("Question: " + $q + "\n\nCommand output:\n" + $d)}]}],
     generationConfig:{temperature:0.3, maxOutputTokens:300}}')
  resp=$(curl -sS --max-time 15 \
    -H "x-goog-api-key: $GEMINI_API_KEY" -H "Content-Type: application/json" \
    -X POST "$GEMINI_BASE_URL/models/$GEMINI_MODEL:generateContent" \
    -d "$body" 2>/dev/null)
  text=$(echo "$resp" | jq -r '[.candidates[0].content.parts[].text] | join("") // empty' 2>/dev/null)
  [[ -n "$text" ]] && { printf '%s\n' "$text"; return 0; }
  return 1
}

llm_explain() {  # question, tool_output
  case "$(_llm_provider)" in
    gemini) _gemini_explain "$1" "$2" ;;
    nim)    _nim_explain "$1" "$2" ;;
    *)      return 1 ;;
  esac
}

# Intent Engine: deterministic keyword routing. Not a language model --
# see ai-agent/README.md for why that's the honest, correct scope here.
dispatch() {
  local q="${1,,}"  # lowercase
  local action tool_cmd output

  if [[ "$q" =~ (slow|performance|why.*lag|sluggish) ]]; then
    action="system.read_health+processes"
    output="$("$BIN/chakra-health"; echo; "$BIN/chakra-processlens")"
  elif [[ "$q" =~ (ram|memory|consuming|which app) ]]; then
    action="system.read_processes"
    output="$("$BIN/chakra-processlens")"
  elif [[ "$q" =~ (network|connection|listening|port) ]]; then
    action="network.read_connections"
    output="$("$BIN/chakra-netguard")"
  elif [[ "$q" =~ (update|upgrade|patch) ]]; then
    action="system.read_updates"
    output="$("$BIN/chakra-health")"
  elif [[ "$q" =~ (security|threat|problem|suspicious|breach) ]]; then
    action="security.read_audit_log"
    output="$("$BIN/chakra-loglens" --source security)"
  elif [[ "$q" =~ (device|usb|bluetooth|hardware|plugged) ]]; then
    action="device.read_inventory"
    output="$("$BIN/chakra-devicewatch")"
  elif [[ "$q" =~ (log|error|journal) ]]; then
    action="system.read_logs"
    output="$("$BIN/chakra-loglens")"
  elif [[ "$q" =~ (health|status|how.*system) ]]; then
    action="system.read_health"
    output="$("$BIN/chakra-health")"
  else
    audit "intent.unmatched" "no_match"
    echo "Sentinel (offline mode) doesn't recognize that yet -- it only routes to known, read-only Chakra system APIs, not open-ended questions."
    echo "Try asking about: system health, processes/memory, network connections, updates, security/logs, or connected devices."
    return 1
  fi

  audit "$action" "success"

  local prov; prov="$(_llm_provider)"
  if [[ "$prov" != none ]]; then
    local explained
    if explained="$(llm_explain "$1" "$output")"; then
      echo "$explained"
      echo
      echo "--- raw data ---"
      echo "$output"
      return 0
    fi
    echo "($prov explain layer configured but unreachable -- showing raw data.)"
    echo
  fi
  echo "$output"
}

_llm_status() {
  case "$(_llm_provider)" in
    gemini) echo "Explain layer: Google Gemini ($GEMINI_MODEL)" ;;
    nim)    echo "Explain layer: NVIDIA NIM ($NIM_MODEL)" ;;
    *)      echo "Explain layer: none (offline pattern-matching only -- set a key in $CONF)" ;;
  esac
}

if [[ $# -gt 0 ]]; then
  dispatch "$*"
else
  echo "Chakra Sentinel -- read-only mode (Risk tier 0 only). Type 'exit' to quit."
  _llm_status
  echo
  while true; do
    read -r -p "sentinel> " query || break
    [[ "$query" =~ ^(exit|quit)$ ]] && break
    [[ -z "$query" ]] && continue
    dispatch "$query"
    echo
  done
fi
