set default=0
set timeout=10

insmod all_video
insmod gfxterm
terminal_output gfxterm

menuentry "Try Chakra OS @@CHAKRA_VERSION@@" {
    linux /live/vmlinuz boot=live components quiet splash
    initrd /live/initrd.img
}

menuentry "Try Chakra OS @@CHAKRA_VERSION@@ (safe graphics)" {
    linux /live/vmlinuz boot=live components nomodeset
    initrd /live/initrd.img
}

menuentry "Try Chakra OS @@CHAKRA_VERSION@@ (debug - verbose boot log)" {
    linux /live/vmlinuz boot=live components
    initrd /live/initrd.img
}

menuentry "Try Chakra OS @@CHAKRA_VERSION@@ (serial console debug)" {
    linux /live/vmlinuz boot=live components console=ttyS0,115200n8
    initrd /live/initrd.img
}

# Recovery mode: boots to a root shell (rescue.target) with the graphical
# stack and most services held back. First command to run: chakra-fixer
# (diagnose), then `sudo chakra-fixer --fix`. See recovery/README.md.
menuentry "Chakra OS @@CHAKRA_VERSION@@ (recovery mode)" {
    linux /live/vmlinuz boot=live components nomodeset systemd.unit=rescue.target
    initrd /live/initrd.img
}

menuentry "Boot from first hard disk" {
    exit
}
