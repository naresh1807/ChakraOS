<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
 "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<!--
  Chakra OS "System Maintenance" menu (Phase 11). Merged via the
  standard XDG DefaultMergeDirs mechanism -- see
  config/chakra-tools-menu/ / config/security-menu/ for the rationale.
-->
<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>ChakraMaintenance</Name>
    <Directory>chakra-maintenance.directory</Directory>
    <Include>
      <Category>X-Chakra-Maintenance</Category>
    </Include>
  </Menu>
</Menu>
