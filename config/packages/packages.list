# Chakra OS v0.1 — base package set installed into the rootfs after debootstrap.
# One package per line. Comments (#) and blank lines are ignored by build_iso.sh.

# Base system
systemd-sysv
sudo
nano
wget
curl
net-tools
git

# Kernel + boot
linux-image-amd64
live-boot
grub-pc-bin
grub-efi-amd64-bin

# Desktop
kde-plasma-desktop
sddm

# Browser (Debian's official package is firefox-esr; there is no plain
# "firefox" package in Debian main due to Mozilla trademark restrictions)
firefox-esr

# Windows 11-style theming (Fluent icon/cursor theme, global theme, Kvantum engine)
qt5-style-kvantum
qt5-style-kvantum-themes

# Networking
network-manager
plasma-nm

# Audio foundation
pipewire
pipewire-pulse
wireplumber
