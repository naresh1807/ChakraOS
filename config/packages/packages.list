# Chakra OS v0.1 — base package set installed into the rootfs after debootstrap.
# One package per line. Comments (#) and blank lines are ignored by build_iso.sh.

# Base system
systemd-sysv
sudo
nano
wget
curl
net-tools
git

# Kernel + boot
linux-image-amd64
live-boot
grub-pc-bin
grub-efi-amd64-bin

# Desktop
kde-plasma-desktop
sddm

# Browser (Debian's official package is firefox-esr; there is no plain
# "firefox" package in Debian main due to Mozilla trademark restrictions)
firefox-esr

# Windows 11-style theming (Fluent icon/cursor theme, global theme, Kvantum engine)
qt5-style-kvantum
qt5-style-kvantum-themes

# Branding polish: boot splash engine + terminal system-info banner.
# fastfetch is not in Debian bookworm main (verified) — neofetch is,
# and is still the more universally available choice.
plymouth
neofetch

# Networking
network-manager
plasma-nm

# Phase 5: security substrate (firewall + audit trail).
nftables
auditd

# Phase 6: read-only observability tools (Chakra system APIs).
dialog
lm-sensors
smartmontools
jq

# Phase 8: permission & privacy enforcement.
usbguard
usbguard-notifier
cryptsetup
firejail

# Phase 9: active defense (Chakra Shield). libnotify-bin = notify-send,
# used by chakra-shield-notify and chakra-usb-prompt for desktop alerts.
libnotify-bin

# Phase 10: developer tooling. podman = rootless, daemonless containers
# (chosen over Docker for a security OS). chakra-apiwatch reuses tcpdump
# (already in from Phase 2).
podman

# Phase 11: system maintenance. needrestart tells chakra-update which
# services need a restart after an upgrade. zstd/tar (chakra-snapshot)
# are already in the base.
needrestart

# Phase 12: performance & daily-use. power-profiles-daemon (Plasma's
# battery applet drives it too), powertop (battery diagnostics),
# plocate (fast file search), xclip + wl-clipboard (terminal clipboard).
power-profiles-daemon
powertop
plocate
xclip
wl-clipboard

# Phase 13: security research. xxd for chakra-lab's hex triage (the RE
# tools -- yara/ssdeep/binwalk/clamav/... -- came in with Phase 2;
# firejail/podman with Phases 8/10). pandoc is optional (chakra-reporter
# renders Markdown natively; HTML needs it) and deliberately not bundled.
xxd

# Phase 14: identity. FIDO2/U2F security-key login (libpam-u2f brings
# pamu2fcfg + pam_u2f.so), fingerprint login (fprintd), and fido2-tools
# for enumerating keys. libfido2 was already pulled in.
libpam-u2f
fprintd
libpam-fprintd
fido2-tools

# Phase 15: mobile ecosystem. kdeconnect (the transport chakra-link wraps
# -- pairing, share, ring, clipboard/notification sync) is normally pulled
# in by kde-plasma-desktop; pinned here explicitly. qdbus (from qttools5,
# already in) reads its D-Bus state.
kdeconnect

# Audio foundation
pipewire
pipewire-pulse
wireplumber

# --- Phase 2: security & forensics tooling ---
# All names below were verified against Debian bookworm's actual package
# index via a dry-run install before being added here. Not apt-installable
# in bookworm main: theharvester, radare2, kismet, upx, bulk-extractor
# (would need pip/source install if wanted later); nikto and Burp Suite
# Community are installed separately in build_iso.sh (install_nikto,
# install_burpsuite) since neither is a Debian package at all; Metasploit
# likewise via install_metasploit (Rapid7's own installer).

# Network security / reconnaissance
nmap
wireshark
tcpdump
aircrack-ng
netcat-openbsd
masscan
arp-scan
netdiscover
# ettercap-graphical and ettercap-text-only are alternate builds that
# conflict (both provide the same ettercap binary) — using the GUI
# version since this is a desktop OS.
ettercap-graphical
iperf3
mtr-tiny

# Wireless security
reaver
wifite

# Web application security testing
sqlmap
dirb
whatweb
wapiti
gobuster
ffuf

# Password / credential testing
hydra
john
hashcat
crunch
cewl
medusa

# Malware analysis
clamav
clamav-daemon
yara
ssdeep

# Reverse engineering
gdb
strace
ltrace
checksec

# OSINT / reconnaissance utilities
whois
dnsutils
recon-ng

# Network monitoring
iftop
nethogs
vnstat

# Digital forensics — disk & file
sleuthkit
autopsy
testdisk
foremost
binwalk
extundelete
scalpel

# Digital forensics — acquisition & hashing
gddrescue
hashdeep
ewf-tools
guymager

# Digital forensics — metadata
libimage-exiftool-perl

# Digital forensics — steganography
steghide
outguess
