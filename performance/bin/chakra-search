#!/bin/bash
# chakra-search -- one query, all the places.
#
# Plasma's KRunner (Alt+Space) and Baloo already do this in the GUI.
# This is the terminal one: a single search across files, installed
# packages, running processes, systemd units, and $PATH commands,
# grouped so you can see where the hit is.
#
# Usage:
#   chakra-search <query>
#   chakra-search --update      refresh the file index now (plocate)
#   chakra-search --files <q>   files only        (also: --pkgs --procs --units --cmds)
set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

want=all
case "${1:-}" in
  --update) exec sudo updatedb ;;
  --files)  want=files; shift ;;
  --pkgs)   want=pkgs;  shift ;;
  --procs)  want=procs; shift ;;
  --units)  want=units; shift ;;
  --cmds)   want=cmds;  shift ;;
  -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
q="${*:-}"
[[ -z "$q" ]] && { echo "usage: chakra-search <query>" >&2; exit 1; }

_hdr() { printf '\n== %s ==\n' "$1"; }

sect() { [[ "$want" == all || "$want" == "$1" ]]; }

if sect files; then
  _hdr "Files"
  if command -v plocate >/dev/null 2>&1; then
    plocate -i -l 20 -- "$q" 2>/dev/null | sed 's/^/  /' || echo "  (none; try 'chakra-search --update' if the index is stale)"
  else
    find / -xdev -iname "*$q*" 2>/dev/null | head -20 | sed 's/^/  /'
  fi
fi

if sect pkgs; then
  _hdr "Installed packages"
  dpkg-query -W -f='${Package}\t${Version}\t${binary:Summary}\n' 2>/dev/null \
    | grep -i -- "$q" | head -15 | awk -F'\t' '{printf "  %-28s %s\n", $1, $3}'
fi

if sect procs; then
  _hdr "Running processes"
  ps -eo pid,user,comm,args --no-headers 2>/dev/null | grep -i -- "$q" | grep -v " grep " | head -12 \
    | awk '{printf "  %-7s %-10s %s\n", $1, $2, $3}'
fi

if sect units; then
  _hdr "systemd units"
  systemctl list-units --all --no-legend --plain 2>/dev/null | grep -i -- "$q" | head -12 | awk '{printf "  %-38s %s %s\n", $1, $3, $4}'
fi

if sect cmds; then
  _hdr "Commands on PATH"
  compgen -c 2>/dev/null | grep -i -- "$q" | sort -u | head -15 | sed 's/^/  /'
fi
echo
