#!/bin/bash
# chakra-loglens -- Chakra system API: unified log viewer.
# Risk tier 0 (read-only).
# Usage: chakra-loglens [--json] [--source boot|kernel|security|app] [--since <time>]
set -u

json_mode=0
source="all"
since="-1h"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) json_mode=1; shift ;;
    --source) source="${2:-all}"; shift 2 ;;
    --since) since="${2:--1h}"; shift 2 ;;
    *) shift ;;
  esac
done

args=(--no-pager -q --since "$since")
case "$source" in
  boot)     args+=(-b) ;;
  kernel)   args+=(-k) ;;
  security) : ;;  # handled separately below (audit log, not journald)
  app)      args+=(--facility=user,daemon) ;;  # syslog "user"+"daemon" = application/service messages
  all|*)    : ;;
esac

# Full-system log reads need privilege: audit.log is root/adm-only, and
# the journal only shows a plain user their own session unless they're in
# adm or systemd-journal. Say so plainly instead of returning a silent
# empty result (which is what this tool used to do, run unprivileged).
privileged=0
{ [[ $EUID -eq 0 ]] || id -nG 2>/dev/null | grep -qwE 'adm|systemd-journal'; } && privileged=1

if [[ "$source" == "security" ]]; then
  if [[ -r /var/log/audit/audit.log ]]; then
    out=$(tail -n 50 /var/log/audit/audit.log 2>/dev/null)
  elif [[ -e /var/log/audit/audit.log ]]; then
    out="(cannot read /var/log/audit/audit.log -- run as root, or add this user to the 'adm' group)"
  else
    out="(no OS audit log at /var/log/audit/audit.log -- is auditd running?)"
  fi
else
  out=$(journalctl "${args[@]}" 2>/dev/null | tail -n 50)
  if [[ -z "$out" && $privileged -eq 0 ]]; then
    out="(cannot read the system journal -- run as root, or add this user to the 'adm' group)"
  fi
fi

if [[ $json_mode -eq 1 ]]; then
  jq -Rs --arg source "$source" --arg since "$since" '{source:$source,since:$since,lines:(split("\n")|map(select(length>0)))}' <<< "$out"
else
  echo "Chakra Log Lens -- source=$source since=$since (last 50 lines)"
  echo "======================================================================"
  echo "$out"
fi
